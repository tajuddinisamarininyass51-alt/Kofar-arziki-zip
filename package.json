{\n  "name": "kofaraziki-data",\n  "version": "1.0.0",\n  "description": "A comprehensive fintech and mobile utility payment platform",\n  "main": "src/app.js",\n  "type": "module",\n  "scripts": {\n    "dev": "nodemon src/app.js",\n    "start": "node src/app.js",\n    "test": "jest --coverage",\n    "test:watch": "jest --watch",\n    "test:coverage": "jest --coverage",\n    "lint": "eslint src/ --max-warnings 0",\n    "lint:fix": "eslint src/ --fix",\n    "format": "prettier --write \\\"src/**/*.js\\\"",\n    "format:check": "prettier --check \\\"src/**/*.js\\\"",\n    "migrate:create": "node scripts/migrate.js create",\n    "migrate:up": "node scripts/migrate.js up",\n    "migrate:down": "node scripts/migrate.js down",\n    "seed": "node scripts/seed.js",\n    "build": "tsc",\n    "prestart": "npm run migrate:up"\n  },\n  "keywords": [\n    "fintech",\n    "payment",\n    "mobile-money",\n    "utility-bills",\n    "airtime",\n    "data",\n    "referral",\n    "wallet"\n  ],\n  "author": "Tajuddini Ahmad (bamimairu)",\n  "license": "MIT",\n  "dependencies": {\n    "express": "^4.18.2",\n    "dotenv": "^16.3.1",\n    "cors": "^2.8.5",\n    "helmet": "^7.1.0",\n    "express-rate-limit": "^7.1.5",\n    "joi": "^17.11.0",\n    "mongoose": "^8.0.0",\n    "bcryptjs": "^2.4.3",\n    "jsonwebtoken": "^9.1.2",\n    "axios": "^1.6.2",\n    "uuid": "^9.0.1",\n    "winston": "^3.11.0",\n    "redis": "^4.6.12",\n    "express-cache-controller": "^1.1.0",\n    "compression": "^1.7.4",\n    "multer": "^1.4.5-lts.1",\n    "sharp": "^0.33.0",\n    "nodemailer": "^6.9.7",\n    "twilio": "^4.10.0",\n    "paystack": "^3.2.0",\n    "moment": "^2.29.4",\n    "lodash": "^4.17.21"\n  },\n  "devDependencies": {\n    "nodemon": "^3.0.2",\n    "jest": "^29.7.0",\n    "supertest": "^6.3.3",\n    "eslint": "^8.54.0",\n    "eslint-config-airbnb-base": "^15.0.0",\n    "eslint-plugin-import": "^2.29.0",\n    "prettier": "^3.1.0",\n    "typescript": "^5.3.2",\n    "@types/node": "^20.10.0",\n    "@types/express": "^4.17.21",\n    "ts-node": "^10.9.1",\n    "db-migrate": "^0.11.13",\n    "db-migrate-mysql": "^2.2.0",\n    "db-migrate-mongodb": "^1.10.0"\n  },\n  "engines": {\n    "node": ">=16.0.0",\n    "npm": ">=8.0.0"\n  },\n  "repository": {\n    "type": "git",\n    "url": "https://github.com/tajuddinisamarininyass51-alt/Kofar-arziki-zip.git"\n  },\n  "bugs": {\n    "url": "https://github.com/tajuddinisamarininyass51-alt/Kofar-arziki-zip/issues"\n  },\n  "homepage": "https://github.com/tajuddinisamarininyass51-alt/Kofar-arziki-zip#readme"\n}\n