# Environment Configuration\n# This file contains all environment variables needed for Kofaraziki Data\n# IMPORTANT: Never commit actual secrets - use this as a template only\n\n# Application\nNODE_ENV=development\nPORT=3000\nAPP_NAME=kofaraziki-data\nAPP_VERSION=1.0.0\nDEBUG=true\n\n# Database\nMONGODB_URI=mongodb://localhost:27017/kofaraziki\nMONGODB_TEST_URI=mongodb://localhost:27017/kofaraziki_test\nDB_POOL_SIZE=10\n\n# Redis Cache\nREDIS_HOST=localhost\nREDIS_PORT=6379\nREDIS_PASSWORD=\nREDIS_DB=0\n\n# JWT Authentication\nJWT_SECRET=your_super_secret_jwt_key_change_this_in_production\nJWT_EXPIRE=7d\nJWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this\nJWT_REFRESH_EXPIRE=30d\n\n# API Configuration\nAPI_BASE_URL=http://localhost:3000\nAPI_TIMEOUT=30000\nAPI_VERSION=v1\n\n# CORS Configuration\nCORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000\nCORS_CREDENTIALS=true\n\n# Rate Limiting\nRATE_LIMIT_WINDOW_MS=900000\nRATE_LIMIT_MAX_REQUESTS=100\n\n# Payment Gateway - Paystack\nPAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here\nPAYSTACK_SECRET_KEY=sk_test_your_secret_key_here\nPAYSTACK_API_URL=https://api.paystack.co\n\n# Payment Gateway - Palmpay (if applicable)\nPALMPAY_API_KEY=your_palmpay_api_key_here\nPALMPAY_MERCHANT_ID=your_merchant_id_here\nPALMPAY_API_URL=https://api.palmpay.io\n\n# Twilio (SMS Notifications)\nTWILIO_ACCOUNT_SID=your_account_sid_here\nTWILIO_AUTH_TOKEN=your_auth_token_here\nTWILIO_PHONE_NUMBER=+1234567890\nTWILIO_ENABLED=false\n\n# Email Configuration - Nodemailer\nSMTP_HOST=smtp.gmail.com\nSMTP_PORT=587\nSMTP_USER=your_email@gmail.com\nSMTP_PASSWORD=your_app_password_here\nSMTP_FROM=noreply@kofaraziki.com\nSMTP_FROM_NAME=Kofaraziki Data\n\n# AWS S3 (if using for file storage)\nAWS_ACCESS_KEY_ID=your_aws_access_key\nAWS_SECRET_ACCESS_KEY=your_aws_secret_key\nAWS_REGION=us-east-1\nAWS_S3_BUCKET=kofaraziki-uploads\n\n# Logging\nLOG_LEVEL=info\nLOG_FORMAT=json\nLOG_FILE=logs/app.log\nLOG_MAX_SIZE=10m\nLOG_MAX_FILES=14\n\n# Security\nBCRYPT_ROUNDS=10\nSESSION_SECRET=your_session_secret_key_change_this\nSANITIZE_DATA=true\n\n# Feature Flags\nFEATURE_TWO_FACTOR_AUTH=true\nFEATURE_REFERRAL_PROGRAM=true\nFEATURE_AFFILIATE_WEBSITE=true\nFEATURE_AIRTIME_TO_CASH=true\nFEATURE_DATA_PLANS=true\nFEATURE_ELECTRICITY_BILLS=true\nFEATURE_CABLE_SUBSCRIPTIONS=true\n\n# Transaction Configuration\nTRANSACTION_CHARGE_PERCENTAGE=1\nTRANSACTION_CHARGE_CAP=50\nMINIMUM_TRANSACTION_AMOUNT=100\nMAXIMUM_TRANSACTION_AMOUNT=100000\n\n# Referral Program\nREFERRAL_BONUS_PERCENTAGE=5\nREFERRAL_PAYOUT_THRESHOLD=1000\nREFERRAL_COMMISSION_PERCENTAGE=2\n\n# Account Configuration\nMINIMUM_ACCOUNT_BALANCE=0\nACCOUNT_VERIFICATION_REQUIRED=true\nAUTOMATIC_WALLET_FUNDING=false\n\n# External APIs\nEXTERNAL_DATA_PROVIDER_API=https://api.dataprovider.com\nEXTERNAL_AIRTIME_PROVIDER_API=https://api.airtimeprovider.com\nEXTERNAL_ELECTRICITY_PROVIDER_API=https://api.electricityprovider.com\n\n# Monitoring & Analytics\nSENTRY_DSN=\nGOOGLE_ANALYTICS_ID=\nDATA_DOG_API_KEY=\n\n# Support & Help\nSUPPORT_EMAIL=support@kofaraziki.com\nSUPPORT_PHONE=+234XXXXXXXXXX\nHELP_DESK_URL=https://help.kofaraziki.com\nCHAT_SUPPORT_ENABLED=true\n\n# Maintenance Mode\nMAINTENANCE_MODE=false\nMAINTENANCE_MESSAGE=System is under maintenance. Please try again later.\n\n# Backup & Recovery\nBACKUP_ENABLED=true\nBACKUP_SCHEDULE=0 2 * * *\nBACKUP_RETENTION_DAYS=30\n\n# Time Zone\nTIME_ZONE=Africa/Lagos\nDATE_FORMAT=YYYY-MM-DD\nTIME_FORMAT=HH:mm:ss\n